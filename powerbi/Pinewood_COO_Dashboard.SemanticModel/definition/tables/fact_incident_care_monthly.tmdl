table fact_incident_care_monthly
	lineageTag: 1508bd1b-b156-405a-9fe0-4a720b7e140d

	measure m_IncidentRatePer100ResidentDays =
			
			
			VAR incidents = SUM('fact_incident_care_monthly'[incident_count])
			
			VAR resident_days = SUM('fact_incident_care_monthly'[resident_days])
			
			RETURN IF( resident_days = 0, BLANK(), incidents / resident_days * 100 )
		formatString: 0.0
		lineageTag: 6e8f9cd4-df14-403b-bb3a-806d1f1a1f44

